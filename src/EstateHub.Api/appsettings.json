{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "EstateHub",
    "Audience": "EstateHub.Api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "RememberMeRefreshTokenDays": 30
  },
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "FromName": "EstateHub"
  },
  "LegalPolicies": {
    "TermsAndConditionsVersion": "1.0",
    "PrivacyPolicyVersion": "1.0"
  },
  "AuthRateLimiting": {
    "Registration": {
      "PermitLimit": 5,
      "WindowSeconds": 600
    },
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "EmailDelivery": {
      "PermitLimit": 3,
      "WindowSeconds": 900
    },
    "TokenLifecycle": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "Verification": {
      "PermitLimit": 10,
      "WindowSeconds": 600
    }
  },
  "AllowedHosts": "*"
}
